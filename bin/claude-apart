#!/bin/bash
# claude-apart: run several Claude Code accounts side by side.
# Without perl the path below would be empty and the source would read a file
# relative to the current folder, so stop first.
command -v perl >/dev/null 2>&1 || { echo "claude-apart: perl not found." >&2; exit 1; }
_ca_self=$(perl -MCwd=abs_path -e 'print abs_path(shift)' "$0") && [ -n "$_ca_self" ] \
  || { echo "claude-apart: cannot find where this script lives." >&2; exit 1; }
. "${_ca_self%/*}/../libexec/claude-apart/lib/common.sh"

usage() {
  cat <<'USAGE'
Usage: claude-apart <command>

  setup | add <name> | remove <name> | login <name> | status | sync | copy <from> <to> | check | new <name> | uninstall [--purge]

Run several Claude Code accounts side by side.
Run claude-apart help for this text.
USAGE
}

# These write into every profile's setup, so never from inside a session.
case "${1:-}" in
  setup|add|remove|login|copy|sync|uninstall)
    if [ "${CLAUDE_CODE_CHILD_SESSION:-}" = 1 ]; then
      echo "claude-apart: run this in a normal terminal, not inside Claude." >&2
      exit 1
    fi ;;
esac

case "${1:-}" in
  sync) . "$CA_ROOT/libexec/claude-apart/cmd/sync.sh"; ca_sync; r=$?; ca_restart_note; exit $r ;;
  check) . "$CA_ROOT/libexec/claude-apart/cmd/check.sh"; shift; ca_check "$@"; exit $? ;;
  copy) . "$CA_ROOT/libexec/claude-apart/cmd/copy.sh"; shift; ca_copy "$@"; exit $? ;;
  new) . "$CA_ROOT/libexec/claude-apart/cmd/new.sh"; shift; ca_new "$@"; exit $? ;;
  uninstall) . "$CA_ROOT/libexec/claude-apart/cmd/uninstall.sh"; shift; ca_uninstall "$@"; exit $? ;;
  login|add|remove|setup|status)
    c=$1; shift
    . "$CA_ROOT/libexec/claude-apart/cmd/$c.sh"
    "ca_$c" "$@"; exit $? ;;
esac

case "${1:-}" in
  help|-h|--help) usage ;;
  *) usage >&2; exit 2 ;;
esac
