#!/bin/bash
# Stand-in for the real Claude Code binary, used only by tests.
echo "CONFIG_DIR=${CLAUDE_CONFIG_DIR-<unset>} PROFILE=${CLAUDE_APART_PROFILE-} ARGS=$*" >> "${FAKE_LOG:-/dev/null}"
if [ "$1" = auth ]; then
  if [ -n "${CLAUDE_CONFIG_DIR-}" ]; then idf="$CLAUDE_CONFIG_DIR/.claude.json"; else idf="$HOME/.claude.json"; fi
  case "$2" in
    login)
      mkdir -p "$(dirname "$idf")"
      printf '{"oauthAccount":{"emailAddress":"%s","organizationUuid":"%s","organizationName":"Example"}}\n' \
        "${FAKE_LOGIN_EMAIL-}" "${FAKE_LOGIN_ORG-}" > "$idf" ;;
    logout)
      [ -f "$idf" ] && printf '{}\n' > "$idf" ;;
  esac
fi
exit "${FAKE_RC:-0}"
